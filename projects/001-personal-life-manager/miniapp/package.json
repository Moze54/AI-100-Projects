{
  "name": "shiji-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "拾记（Shiji）— 个人信息收纳与生活管理小程序（uni-app 跨端工程）",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "type-check": "vue-tsc --noEmit",
    "icons": "python scripts/gen-icons.py",
    "tabbar": "python scripts/gen-custom-tabbar.py",
    "images": "python scripts/optimize-images.py"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "sass": "^1.77.8",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
